{
	"name": "guitar",
	"version": "1.0.0",
	"description": "Campfire songs",
	"exports": "./src/index.js",
	"scripts": {
		"prestart": "babel-node tools/startMessage.js",
		"start": "npm-run-all --parallel open:src",
		"open:src": "babel-node tools/srcServer.js",
		"build:html": "babel-node tools/buildHtml.js",
		"build:dev": "webpack --config ./webpack.config.dev.js",
		"build:bookmarklets": "babel-node tools/buildBookmarklets.js",
		"build:prod": "webpack --config ./webpack.config.prod.js",
		"lint": "eslint src/",
		"bounce": "rm -rf node_modules && yarn install",
		"ts-check": "npx tsc",
		"prepare": "husky",
		"test": "jest",
		"test:coverage": "jest --coverage",
		"test:watch": "jest --watch"
	},
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/travishoki/guitar-music.git"
	},
	"author": "Travis Hoki",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/travishoki/guitar-music/issues"
	},
	"engines": {
		"node": ">=20"
	},
	"homepage": "https://github.com/travishoki/guitar-music#readme",
	"dependencies": {
		"jest": "30",
		"npm-run-all": "4.1.5",
		"react": "19",
		"react-dom": "19",
		"react-hot-toast": "^2.6.0",
		"react-router-dom": "7"
	},
	"devDependencies": {
		"@babel/cli": "^7",
		"@babel/core": "^7",
		"@babel/node": "^7",
		"@babel/plugin-transform-object-rest-spread": "^7",
		"@babel/preset-env": "^7",
		"@babel/preset-react": "^7",
		"@eslint/js": "^9",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@testing-library/jest-dom": "^7.0.0",
		"@types/jest": "30",
		"@types/lodash": "^4.17.24",
		"@types/react": "19",
		"@types/react-dom": "19",
		"babel-loader": "^10.1.1",
		"babel-plugin-module-resolver": "^5.0.3",
		"colors": "^1.4.0",
		"css-loader": "^7.1.4",
		"eslint": "^9",
		"eslint-config-prettier": "^10.1.8",
		"eslint-import-resolver-alias": "^1.1.2",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-no-only-tests": "^3.4.0",
		"eslint-plugin-prettier": "^5.5.6",
		"eslint-plugin-promise": "^7.3.0",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-sort-destructure-keys": "^3.0.0",
		"eslint-plugin-typescript-sort-keys": "^3.3.0",
		"eventsource-polyfill": "0.9.6",
		"express": "^5.2.1",
		"file-loader": "6.2.0",
		"html-webpack-plugin": "^5.6.8",
		"husky": "^9.1.7",
		"jsdom": "22.1.0",
		"json-loader": "^0.5.7",
		"less": "^4.8.1",
		"less-loader": "^13.0.0",
		"lint-staged": "^16",
		"open": "^11.0.0",
		"prettier": "^3.9.6",
		"style-loader": "^4.0.0",
		"terser-webpack-plugin": "^5.6.1",
		"ts-jest": "^29.4.12",
		"ts-loader": "^9.6.2",
		"typescript": "~5.9",
		"typescript-eslint": "^8.65.0",
